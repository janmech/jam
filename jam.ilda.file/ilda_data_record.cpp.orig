#include "ilda_data_record.hpp"

namespace jam::ilda{
    
    void IldaDataRecord::setPosX(int pos_x) {
        this->pos_x = this->_clipPositionValue(pos_x);
    }
    int IldaDataRecord::getPosX(){
        return this->pos_x;
    };
    void IldaDataRecord::setPosY(int pos_y){
        this->pos_y = this->_clipPositionValue(pos_y);
    };
    int IldaDataRecord::getPosY() {
        return this->pos_y;
    };
    void IldaDataRecord::setPosZ(int pos_z){
        this->pos_z = this->_clipPositionValue(pos_y);
    };
    int IldaDataRecord::getPosZ(){
        return this->pos_z;
    };
    void IldaDataRecord::setColorIndex(uint8_t color_index) {
        this->color_index = color_index;
    };
    uint8_t IldaDataRecord::getColorIndex() {
        return this->color_index;
    };
    void IldaDataRecord::setRed(uint8_t red) {
        this->red = red;
    };
    uint8_t IldaDataRecord::getRed() {
        return this->red;
    };
    void IldaDataRecord::setGreen(uint8_t green) {
        this->green = green;
    };
    uint8_t IldaDataRecord::getGreen(){
        return this->green;
    };
    void IldaDataRecord::setBlue(uint8_t blue) {
        this->blue = blue;
    };
    uint8_t IldaDataRecord::getBlue() {
        return this->blue;
    };
    void IldaDataRecord::setLastPoint(bool last_point) {
        this->last_point = last_point;
    };
    bool IldaDataRecord::getLastPoint() {
        return this->last_point;
    };
    void IldaDataRecord::setBlanking(bool blanking) {
        this->blanking = blanking;
    };
    bool IldaDataRecord::getBlanking() {
        return this->blanking;
    };
    void IldaDataRecord::parseStatusByte(uint8_t status_byte){
        bool last_point = (status_byte & 0b10000000) > 0;
        bool blanking = (status_byte & 0b01000000) > 0;
        this->setLastPoint(last_point);
        this->setBlanking(blanking);
    };
    
